<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ملاحظاتي</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --yellow: #FFD700;
            --yellow-light: #FFF4B2;
            --yellow-dark: #E6C200;
            --purple: #6C3FC5;
            --purple-light: #9B72E0;
            --purple-dark: #4A2A8A;
        }

        * { font-family: 'Tajawal', sans-serif; }

        body {
            background-color: #F9F5FF;
            min-height: 100vh;
        }

        /* NAVBAR */
        .navbar {
            background: linear-gradient(135deg, var(--purple-dark), var(--purple));
            box-shadow: 0 4px 12px rgba(108,63,197,0.3);
        }
        .navbar-brand {
            color: var(--yellow) !important;
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: 1px;
        }
        .navbar-brand:hover { color: var(--yellow-dark) !important; }

        .btn-add-note {
            background-color: var(--yellow);
            color: var(--purple-dark);
            font-weight: 700;
            border: none;
            border-radius: 25px;
            padding: 8px 20px;
            transition: all 0.2s;
        }
        .btn-add-note:hover {
            background-color: var(--yellow-dark);
            color: var(--purple-dark);
            transform: scale(1.05);
        }

        /* FOOTER */
        footer {
            background: var(--purple-dark);
            color: var(--yellow-light);
            text-align: center;
            padding: 16px;
            margin-top: 60px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-controller="Notes" asp-action="Index">
                📝 ملاحظاتي
            </a>
            <a class="btn btn-add-note ms-auto" asp-controller="Notes" asp-action="Create">
                + ملاحظة جديدة
            </a>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer>
        <small>© @DateTime.Now.Year - تطبيق الملاحظات</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
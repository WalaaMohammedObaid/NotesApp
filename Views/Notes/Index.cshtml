@model IEnumerable<NotesApp.Models.Note>
@{
    ViewData["Title"] = "ملاحظاتي";
    var search = ViewData["Search"] as string;
}

<style>
    /* SEARCH BAR */
    .search-wrapper {
        background: linear-gradient(135deg, var(--purple), var(--purple-light));
        border-radius: 20px;
        padding: 24px;
        margin-bottom: 32px;
        box-shadow: 0 6px 20px rgba(108,63,197,0.2);
    }

        .search-wrapper h4 {
            color: var(--yellow);
            font-weight: 700;
            margin-bottom: 14px;
        }

    .search-input {
        border: 3px solid var(--yellow);
        border-radius: 30px 0 0 30px !important;
        padding: 10px 20px;
        font-size: 1rem;
        background: white;
        outline: none;
    }

        .search-input:focus {
            box-shadow: none;
            border-color: var(--yellow-dark);
        }

    .search-btn {
        background: var(--yellow);
        color: var(--purple-dark);
        font-weight: 700;
        border: none;
        border-radius: 0 30px 30px 0 !important;
        padding: 10px 22px;
    }

        .search-btn:hover {
            background: var(--yellow-dark);
        }

    .clear-btn {
        background: rgba(255,255,255,0.2);
        color: white;
        border: 1px solid rgba(255,255,255,0.4);
        border-radius: 25px;
        padding: 6px 16px;
        font-size: 0.85rem;
        margin-top: 10px;
        text-decoration: none;
    }

        .clear-btn:hover {
            background: rgba(255,255,255,0.35);
            color: white;
        }

    /* NOTE CARD */
    .note-card {
        background: white;
        border-radius: 16px;
        border: none;
        box-shadow: 0 4px 16px rgba(108,63,197,0.1);
        transition: transform 0.2s, box-shadow 0.2s;
        border-top: 5px solid var(--yellow);
        height: 100%;
    }

        .note-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(108,63,197,0.2);
        }

        .note-card .card-title {
            color: var(--purple-dark);
            font-weight: 700;
            font-size: 1.1rem;
        }

        .note-card .card-text {
            color: #555;
            font-size: 0.95rem;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

    .note-date {
        font-size: 0.78rem;
        color: var(--purple-light);
        margin-bottom: 12px;
    }

    .btn-edit {
        background: var(--purple);
        color: white;
        border: none;
        border-radius: 20px;
        padding: 5px 16px;
        font-size: 0.85rem;
    }

        .btn-edit:hover {
            background: var(--purple-dark);
            color: white;
        }

    .btn-delete {
        background: transparent;
        color: #dc3545;
        border: 1px solid #dc3545;
        border-radius: 20px;
        padding: 5px 16px;
        font-size: 0.85rem;
    }

        .btn-delete:hover {
            background: #dc3545;
            color: white;
        }

    /* EMPTY STATE */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: var(--purple-light);
    }

        .empty-state .icon {
            font-size: 4rem;
            margin-bottom: 16px;
        }

    /* RESULT COUNT */
    .result-badge {
        background: var(--yellow-light);
        color: var(--purple-dark);
        border-radius: 20px;
        padding: 4px 14px;
        font-size: 0.85rem;
        font-weight: 700;
        border: 1px solid var(--yellow);
    }
</style>

<!-- Search Bar -->
<div class="search-wrapper">
    <h4>🔍 البحث في الملاحظات</h4>
    <form asp-action="Index" method="get">
        <div class="input-group">
            <input type="text"
                   name="search"
                   class="form-control search-input"
                   placeholder="ابحث بالعنوان أو المحتوى..."
                   value="@search" />
            <button type="submit" class="btn search-btn">بحث</button>
        </div>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" class="clear-btn d-inline-block mt-2">✕ مسح البحث</a>
        }
    </form>
</div>

<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="color: var(--purple-dark); font-weight:700;">
        @if (!string.IsNullOrEmpty(search))
        {
            <span>نتائج البحث عن: "<em>@search</em>"</span>
        }
        else
        {
            <span>جميع الملاحظات</span>
        }
    </h5>
    <span class="result-badge">@Model.Count() ملاحظة</span>
</div>

<!-- Notes Grid -->
@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var note in Model)
        {
            <div class="col-md-4 col-sm-6">
                <div class="note-card card p-3">
                    <div class="card-body p-0">
                        <p class="note-date">🕐 @note.CreatedAt.ToString("dd/MM/yyyy - hh:mm tt")</p>
                        <h5 class="card-title">@note.Title</h5>
                        <p class="card-text">@note.Content</p>
                    </div>
                    <div class="card-footer bg-transparent border-0 d-flex gap-2 p-0 pt-3">
                        <a asp-action="Edit" asp-route-id="@note.Id" class="btn btn-edit">✏️ تعديل</a>
                        <a asp-action="Delete" asp-route-id="@note.Id" class="btn btn-delete">🗑️ حذف</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <div class="icon">📭</div>
        <h5>
            @if (!string.IsNullOrEmpty(search))
            {
                <span>لا توجد نتائج للبحث عن "@search"</span>
            }
            else
            {

                <span>لا توجد ملاحظات بعد!</span>
            }
        </h5>
        <p>ابدأ بإضافة ملاحظتك الأولى.</p>
        <a asp-action="Create" class="btn btn-add-note mt-2">+ أضف ملاحظة</a>
    </div>
}
